# Xcode
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Fastlane / archives
*.ipa
*.dSYM.zip
*.dSYM
build/

# Private keys must never reach this repo — it is public, and the Apple
# WeatherKit .p8 can only be downloaded once. Belt as well as braces: the key
# itself lives in ~/.config/rainyclock/, outside the working tree.
*.p8
DerivedDataDevice/

# Backend dependencies and local emulator state; no production credentials.
weather-proxy/node_modules/
weather-proxy/.env*
weather-proxy/*debug.log
weather-proxy/.firebase/

# Duplicate archives of the variant PNGs beside them; docs/ is published, keep it lean.
docs/weather-variants-*/*.zip
