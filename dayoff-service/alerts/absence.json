{
  "displayName": "rainyclock-dayoff poll absent",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "no dayoff_job summary in 15 minutes",
      "conditionAbsent": {
        "filter": "resource.type = \"cloud_run_job\" AND metric.type = \"logging.googleapis.com/user/dayoff_job_runs\"",
        "duration": "900s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ]
      }
    }
  ],
  "notificationChannels": [
    "projects/rainyclock/notificationChannels/10219649454523194367"
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "The poll Job has not logged a summary for 15 minutes. Runbook in dayoff-service/DEPLOYMENT.md (運行手冊)."
  }
}