# Obtain a member API key from https://alerts.ncdr.nat.gov.tw/web/developer/alerts-api
# Keep the real key in your host's secret manager; never ship it in the iOS app.
NCDR_API_KEY=
PORT=8081
HOST=127.0.0.1
# Mount a persistent volume here in a cloud deployment. Run one poller instance.
DATA_DIR=./data
# Defaults: 5 minutes between polls, at most 15 minutes since successful validation.
POLL_INTERVAL_MS=300000
MAX_CACHE_AGE_MS=900000
REQUEST_TIMEOUT_MS=10000
# Optional APNs. Leave all four fields empty for fetch-only mode.
# This is a separate APNs key, NOT a WeatherKit key. Do not place it in this repo.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=
APNS_PRODUCTION=false
