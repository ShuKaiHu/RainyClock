# Copy to .env for `npm run local` (node --env-file-if-exists=.env src/local.js). Blank
# values fall back to the defaults noted here. Cloud Run gets its settings from
# the deploy commands and Secret Manager, never from this file.

# --- Firestore (Job and service; local mode only under the emulator) -------
# Emulator runs need a demo- project, e.g. demo-rc-dayoff, and never reach a
# real database. Production: GOOGLE_CLOUD_PROJECT=rainyclock,
# DAYOFF_FIRESTORE_DATABASE=dayoff-production. "(default)" is refused.
GOOGLE_CLOUD_PROJECT=
DAYOFF_FIRESTORE_DATABASE=
# Default dayoff_production_v1; every document path is prefixed with it.
# The sandbox stack uses dayoff_sandbox_v1 (NCDR_SOURCE=fixture needs "sandbox").
DAYOFF_NAMESPACE=
# Local only: 127.0.0.1:8686 (firebase.json). Unset means the memory store.
FIRESTORE_EMULATOR_HOST=

# --- Request-only service: src/server.js ------------------------------------
# Cloud Run injects PORT; 8080 and 0.0.0.0 are the defaults. Local mode always
# listens on 127.0.0.1.
PORT=
HOST=
# 900000: a snapshot older than 15 minutes is served as 503 stale_cache.
MAX_CACHE_AGE_MS=
# 5000: one Firestore read per instance per window during a push burst.
SNAPSHOT_CACHE_MS=
# 1 when the Job has APNs credentials; the service never holds them itself.
PUSH_CONFIGURED=
# alert (default) or background; must match the Job's setting.
APNS_PUSH_MODE=
# 1 on Cloud Run so the rate limiter keys on the last X-Forwarded-For entry
# (the peer Cloud Run appends; everything before it is client-supplied).
TRUST_PROXY=

# --- Poll Job: src/job.js ---------------------------------------------------
# NCDR member key from https://alerts.ncdr.nat.gov.tw/web/developer/alerts-api.
# Keep the real key in Secret Manager; never ship it in the iOS app.
# member: needs NCDR_API_KEY. open-data: keyless data.gov.tw URL, NCDR_API_KEY must stay blank.
# fixture: no NCDR at all; the Job serves fixture/current (written by
# `npm run fixture -- set ...`). Refused unless DAYOFF_NAMESPACE contains
# "sandbox", so production can never be pointed at it.
NCDR_SOURCE=member
NCDR_API_KEY=
# 300000: 5 minutes between polls, also the Scheduler cadence; minimum 60000.
POLL_INTERVAL_MS=
# 10000: per-request deadline, including the response stream.
REQUEST_TIMEOUT_MS=
# 16 (1..64) concurrent APNs sends; 200 (50..500) devices per page.
BROADCAST_CONCURRENCY=
BROADCAST_PAGE_SIZE=
# 120000 lease, renewed every 30000; the renewal must be shorter than the lease.
LEASE_MS=
LEASE_RENEW_MS=
# 420000: the broadcast stops at its next page after this and resumes on retry.
RUN_BUDGET_MS=
# Optional https origin of the deployed service, warmed once before a broadcast.
DAYOFF_SERVICE_URL=
# Optional APNs. Leave all four fields empty for fetch-only mode. This is a
# separate APNs key, NOT a WeatherKit key. Do not place it in this repo.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=
# Required with APNs: false for Xcode Debug builds, true for TestFlight/App Store.
APNS_PRODUCTION=
# CLOUD_RUN_EXECUTION is injected by Cloud Run and only overridden in tests.
